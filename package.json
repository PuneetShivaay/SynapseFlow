{
  "name": "synapseflow",
  "version": "0.1.0",
  "description": "A graph-first AI agent SDK with autonomous memory management and multi-agent orchestration",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && tsc --project tsconfig.build.json",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "graph",
    "memory",
    "typescript",
    "openai",
    "claude",
    "autonomous",
    "multi-agent"
  ],
  "author": "SynapseFlow Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PuneetShivaay/SynapseFlow.git"
  },
  "bugs": {
    "url": "https://github.com/PuneetShivaay/SynapseFlow/issues"
  },
  "homepage": "https://synapseflow.dev",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "nanoid": "^5.1.16",
    "openai": "^7.5.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
